# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Token de @BotFather
TELEGRAM_BOT_TOKEN=

# Credenciales de PostgreSQL
DB_USER=
DB_PASSWORD=
DB_NAME=

# Clave para cifrar los enlaces de Moodle. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Solo durante una rotación de clave: la clave anterior, para poder descifrar
# los enlaces viejos. Después ejecuta `python bot/rotar_clave.py` y bórrala.
FERNET_KEY_ANTERIOR=

# Tu ID de Telegram (para /stats)
ADMIN_ID=
